# Copy to .env and fill in real values. Never commit .env.

# Local Postgres (docker-compose) or Supabase connection string when deployed
DATABASE_URL=postgresql+psycopg2://gitdash:gitdash@localhost:5432/gitdash

# GitHub Personal Access Token (repo scope for private repos; public_repo is enough for public)
GITHUB_TOKEN=ghp_your_token_here

# Comma-separated origins allowed to call the API (Vite local + Vercel later)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# How often the background job re-syncs GitHub data (minutes)
SYNC_INTERVAL_MINUTES=60

# Days without activity before open PRs/issues count as stale
STALE_DAYS=14

# Optional GitHub webhook HMAC secret (Settings → Webhooks → Secret)
GITHUB_WEBHOOK_SECRET=

# Self uptime probe target + interval
UPTIME_CHECK_URL=http://127.0.0.1:8000/health
UPTIME_INTERVAL_MINUTES=5

# Multi-user JWT auth (required in production — change from defaults)
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRE_MINUTES=10080

# Fernet key for encrypting per-user GitHub PATs at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is derived from JWT_SECRET (fine for local; set explicitly in prod)
TOKEN_ENCRYPTION_KEY=

# Seeded once by migration 004 for existing tracked repos (default password: changeme)
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
